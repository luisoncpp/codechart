{
  "regex-auto-approver": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path');const t=['plugins/regex-permissions/auto_approve.cjs','.agents/plugins/regex-permissions/auto_approve.cjs'].find(f=>fs.existsSync(f));if(t)require(p.resolve(t));else process.exit(1);\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
