{
  "name": "codechart",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "posttauri": "npm run clean:target",
    "dist:win": "tauri build --bundles nsis,msi",
    "postdist:win": "node scripts/clean-target.mjs --release",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "playtest:mcp": "node tools/playtest-mcp/index.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:rust && npm run check:arch",
    "check:rust": "cd src-tauri && cross-env TS_RS_EXPORT_DIR=../src/domain/graph/model cargo test",
    "postcheck:rust": "npm run clean:target",
    "check:arch": "cd src-tauri && cargo run --quiet --bin codechart-cli -- check ..",
    "clean:target": "node scripts/clean-target.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.11.0",
    "elkjs": "^0.11.1",
    "marked": "^18.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "fallow": "^2.104.0",
    "jsdom": "^26",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8",
    "vite": "^7.0.4",
    "vitest": "^3",
    "zod": "^4.6.7"
  }
}
